# .gitignore — Student OS
# Android / Gradle standard ignores

# ── Gradle ────────────────────────────────────────────────────────────────────
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradle-wrapper.jar

# ── Android Studio / IntelliJ ─────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
local.properties

# ── Build outputs ─────────────────────────────────────────────────────────────
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Room schema exports ────────────────────────────────────────────────────────
# Schema files ARE committed so migrations can be verified.
# Do NOT add app/schemas/ here.

# ── Sensitive ────────────────────────────────────────────────────────────────
# API keys are stored in EncryptedSharedPreferences at runtime — never in files.
# local.properties (already listed above) is excluded to prevent accidental
# ANDROID_HOME or SDK paths being committed.
google-services.json
keystore.jks
*.keystore
signing.properties
