<?xml version="1.0" encoding="utf-8"?>
<!--
    backup_rules.xml
    Controls Auto Backup behaviour (Android < 12, API < 31).
    Mirrors the exclusions in data_extraction_rules.xml for older devices.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
